# ======================
# 1. 虚拟环境（必须排除）
# ======================
.venv/
.venv_torch/
venv/
env/

# ======================
# 2. Python 缓存/临时文件
# ======================
__pycache__/
*.py[cod]
*$py.class
.egg-info/
.pytest_cache/

# ======================
# 3. IDE/编辑器配置
# ======================
.idea/
.vscode/
*.swp
*.swo

# ======================
# 4. 系统/隐藏文件
# ======================
Thumbs.db
Desktop.ini

# ======================
# 5. 文档/报告（不需要上传）
# ======================
*.doc
*.docx
*.md
*.txt

# ======================
# 6. PowerShell 脚本（不需要上传）
# ======================
*.ps1
_make_*.ps1

# ======================
# 7. 数据文件中的模型（不需要上传）
# ======================
data/*.pt
